APP_NAME=Letters2Santa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Melbourne
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=letters2santa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=l2s_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=l2s_

# Mail: use 'ses' in production (region below), 'log' or SMTP locally.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="workshop@letters2santa.com"
MAIL_FROM_NAME="Santa's Workshop"
MAIL_ELF_FROM=workshop@letters2santa.com
MAIL_SANTA_FROM=santa@letters2santa.com
MAIL_REPLY_TO=workshop@letters2santa.com

# AWS: S3 (private bucket), SES, Rekognition all use these credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_ROOT=
AWS_USE_PATH_STYLE_ENDPOINT=false
UPLOADS_DISK=s3
SIGNED_URL_MINUTES=30

# Stripe (test keys until go-live)
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Letters2Santa product settings (see config/letters.php)
LETTER_PRICE_CENTS=100
CREDIT_PRICE_CENTS=80
CREDITS_MIN=20
CREDITS_MAX=2000
CREDITS_STEP=10
SANTA_DATE=2026-12-25
SANTA_SEND_TIME=07:00
SANTA_CUTOFF_AT="2026-12-24 18:00"
SANTA_CUTOFF_TZ=Australia/Sydney
LATE_SEND_DELAY_MINUTES=30
SANTA_VARIANTS=4
EMAIL_RATE_PER_MINUTE=300
REKOGNITION_ENABLED=false
WALL_SHOW_SAMPLES=true
WALL_SAMPLE_THRESHOLD=500
RETENTION_DAYS_AFTER_SANTA=90
AI_SANTA_REPLY=false
SUPPORT_EMAIL=workshop@letters2santa.com

# Cloudflare Turnstile (party pages)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
